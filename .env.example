# ===========================================================================
# BiblioMóvil Web (Angular) — variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
#
# El frontend es una SPA estática: no lee variables en tiempo de ejecución.
# La configuración se fija en tiempo de BUILD:
#   - Desarrollo (`npm start`): usa src/environments/environment.development.ts
#     (apiUrl http://localhost:3000/api). No necesita este archivo.
#   - Producción / Docker: el marcador `__API_URL__` de
#     src/environments/environment.ts se sustituye con el valor de API_URL.
#
# Uso con Docker:
#   docker build --build-arg API_URL=$API_URL -t bibliomovil-web .
# Uso con docker compose (desde la carpeta raíz, lee este valor del .env):
#   docker compose up --build
# Build manual:
#   sed -i "s#__API_URL__#$API_URL#" src/environments/environment.ts && npm run build
# ===========================================================================

# URL pública de la API NestJS, incluyendo el prefijo /api (sin barra final).
API_URL=http://localhost:3000/api
